{
  "name": "pattern-ai-core",
  "version": "0.1.0",
  "description": "Parametric AI pattern generator core for FreeSewing & Streetwear/Anime pattern-making",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/server/public', 'dist/server/public', {recursive: true, force: true}))\"",
    "experiment:geometry": "node experiments/geometry-kernel/runner.mjs",
    "experiment:semantic": "node experiments/semantic-kernel/runner.mjs",
    "experiment:harness": "node experiments/agent-harness/runner.mjs",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@flatten-js/core": "1.6.14",
    "@freesewing/core": "^3.0.0",
    "archiver": "^8.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "makerjs": "0.19.2",
    "pdfkit": "^0.15.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.7",
    "@types/svg-to-pdfkit": "^0.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
