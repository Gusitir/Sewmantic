# ===================================================================
# pattern-ai-core — Configuración de Variables de Entorno (.env)
# ===================================================================

# 1. Clave de API de Fireworks AI (Requerida para Direct API con DeepSeek)
# Obtén tu API Key en: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=tu_fireworks_api_key_aqui

# 2. Modelo de Texto / Razonamiento para Generación de Moldería y JSON
# Recomendado: accounts/fireworks/models/deepseek-v3 (Ultra rápido, preciso y económico)
# Alternativa:  accounts/fireworks/models/deepseek-r1 (Razonamiento profundo)
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v3

# 3. Modelo de Visión Multimodal para Análisis de Bocetos / Imágenes (PNG, JPG, WEBP)
# Recomendado: accounts/fireworks/models/llama-v3p2-11b-vision-instruct (Rápido y económico)
# Alternativa:  accounts/fireworks/models/qwen2-vl-72b-instruct (Máxima precisión visual)
FIREWORKS_VISION_MODEL=accounts/fireworks/models/llama-v3p2-11b-vision-instruct

# 4. URL Base del Endpoint de Inferencia (Compatible con OpenAI API)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# 5. Proveedor por Defecto ('api' o 'mock')
AI_PROVIDER=api

# 6. Puerto del Servidor Web Studio (Opcional, por defecto 3030)
PORT=3030
