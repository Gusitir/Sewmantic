# ===================================================================
# pattern-ai-core — Configuración de Variables de Entorno (.env)
# ===================================================================

# 1. API Key de Google (Gemini API) — OPCIONAL
# Alternativa recomendada: autenticación OAuth (ADC) sin API key.
#   Ejecuta una vez:  gcloud auth application-default login
#   luego deja GOOGLE_API_KEY vacío y el SDK autentica con tu cuenta de Google
#   (factura al proyecto GCP, ideal para créditos tipo AI Plus).
# Si prefieres API key, dos caminos según el tipo de clave:
#   A) Clave creada en Google AI Studio (restringida a la Generative Language API)
#      → https://aistudio.google.com/apikey  (la más común)
#      → usa el modo Developer API: GOOGLE_GENAI_USE_ENTERPRISE=false (abajo)
#   B) Clave creada en Cloud Console (sin restricción o restringida a Vertex AI API)
#      → https://console.cloud.google.com/apis/credentials
#      → usa el modo enterprise: GOOGLE_GENAI_USE_ENTERPRISE=true
# Si tu clave da error "API_KEY_SERVICE_BLOCKED", es que está restringida a otra API: cambia el modo.
GOOGLE_API_KEY=

# 2. Modo de acceso a Gemini:
#   false = Gemini Developer API (generativelanguage.googleapis.com) — clave de AI Studio
#   true  = Gemini Enterprise Agent Platform (aiplatform.googleapis.com) — OAuth/ADC o clave de Cloud Console
GOOGLE_GENAI_USE_ENTERPRISE=true

# 3. Solo necesario en modo enterprise: proyecto y ubicación.
#    'global' enruta automáticamente a una región con el modelo disponible.
GOOGLE_CLOUD_PROJECT=tu_project_id_gcp
GOOGLE_CLOUD_LOCATION=global

# 4. Modelo de análisis: Gemini 3.8 Flash con nivel de razonamiento HIGH
# ID oficial: gemini-3.8-flash (el "High" es el nivel de thinking, no parte del ID)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=HIGH

# 5. Endpoint REST opcional (solo proxies/custom; si no, el SDK usa el default del modo)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 6. Timeout de llamada IA en ms (opcional, por defecto 90000)
AI_TIMEOUT_MS=90000

# 7. Proveedor por Defecto ('gemini', 'api'/'fireworks' como legado, o 'mock')
AI_PROVIDER=gemini

# 8. Puerto del Servidor Web Studio (Opcional, por defecto 3030)
PORT=3030

# -------------------------------------------------------------------
# LEGADO: Fireworks AI / Qwen 3.8 Max (se mantiene solo como fallback;
# ya no es el proveedor de análisis por defecto)
# -------------------------------------------------------------------
# FIREWORKS_API_KEY=tu_fireworks_api_key_aqui
# FIREWORKS_MODEL=accounts/fireworks/models/qwen3p8-max
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
