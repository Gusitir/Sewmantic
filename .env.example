# ===================================================================
# pattern-ai-core — Configuración de Variables de Entorno (.env)
# ===================================================================

# 1. Clave de API de Fireworks AI
# Obtén tu API Key en: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=tu_fireworks_api_key_aqui

# 2. Modelo Principal Multimodal en Fireworks AI (Qwen 3.8 Max)
# Soporta texto, visión de bocetos/imágenes y generación paramétrica en 1 solo paso:
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p8-max

# 3. URL Base del Endpoint de Fireworks AI
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# 4. Proveedor por Defecto ('api' o 'mock')
AI_PROVIDER=api

# 5. Puerto del Servidor Web Studio (Opcional, por defecto 3030)
PORT=3030
